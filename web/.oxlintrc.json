{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "jsx-a11y", "typescript", "unicorn", "oxc", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],
    "react/react-in-jsx-scope": "off",
    "vitest/valid-expect": ["error", { "maxArgs": 2 }],
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/label-has-associated-control": ["error", { "controlComponents": ["Switch", "Input", "Textarea", "Checkbox", "RadioGroupItem"], "depth": 4 }]
  },
  "overrides": [
    {
      "files": ["src/components/ui/**"],
      "rules": {
        "react/only-export-components": "off",
        "jsx-a11y/prefer-tag-over-role": "off",
        "jsx-a11y/label-has-associated-control": "off",
        "eslint/no-shadow": "off"
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": { "react/only-export-components": "off" }
    }
  ],
  "ignorePatterns": ["dist/**", "src/routeTree.gen.ts", "src/api/schema.d.ts", "src/test/legacy/**"]
}
